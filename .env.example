
# ArcAnalytics Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration (Supabase PostgreSQL)
# Get your connection string from Supabase Dashboard > Settings > Database
DATABASE_URL=postgresql://postgres:your_password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Configuration
# Get these from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Environment
ENVIRONMENT=production

# Roboflow Configuration
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=arcanalytics
ROBOFLOW_WORKFLOW_ID=sam3
ROBOFLOW_API_URL=https://serverless.roboflow.com

# TribeV2 Configuration
# IMPORTANT: Deploy the separate Modal app first, then add the URL here
# Example: https://molyleelatham--tribev2-ad-scorer-tribeapp-serve.modal.run
# If empty, brain analysis will be skipped (app will still work)
TRIBEV2_URL=
TRIBEV2_TIMEOUT=120

# AI Model Configuration
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Observability
LOGFIRE_TOKEN=your_logfire_token_here

# Frontend Configuration
CORS_ORIGINS=https://your-frontend-url.vercel.app
