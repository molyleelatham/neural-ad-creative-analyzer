# ArcAnalytics Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration (Render PostgreSQL)
# Render will automatically set DATABASE_URL when deployed
# For local development, update with your Render database URL
DATABASE_URL=

# Environment
ENVIRONMENT=production

# Roboflow Configuration
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_WORKSPACE=arcanalytics
ROBOFLOW_WORKFLOW_ID=sam3
ROBOFLOW_API_URL=https://serverless.roboflow.com

# TribeV2 Configuration
# Modal app URL - update with your deployed Modal app URL
TRIBEV2_URL=https://your-app-name--tribev2-ad-scorer-tribeapp-serve.modal.run
TRIBEV2_TIMEOUT=120

# AI Model Configuration
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Observability
LOGFIRE_TOKEN=your_logfire_token_here

# Frontend Configuration
CORS_ORIGINS=https://your-frontend-url.onrender.com