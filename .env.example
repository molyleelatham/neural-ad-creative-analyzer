# ── Roboflow (SAM3 visual segmentation) ──────────────────────────────────────
ROBOFLOW_API_KEY=your_roboflow_api_key
ROBOFLOW_WORKSPACE=arcanalytics
ROBOFLOW_WORKFLOW_ID=sam3
ROBOFLOW_API_URL=https://serverless.roboflow.com
# Optional: override the image input key if your workflow uses a different name
ROBOFLOW_IMAGE_KEY=image

# ── TribeV2 (Modal GPU brain scoring) ────────────────────────────────────────
# Set this to your deployed Modal endpoint URL
TRIBEV2_URL=https://arcanalytics--tribev2-ad-scorer-tribeapp-serve.modal.run
# Timeout in seconds (Modal cold starts can take 30-60s)
TRIBEV2_TIMEOUT=120

# ── LLM Narrative (Gemini / OpenAI) ──────────────────────────────────────────
# At least one key required for AI-generated summaries; template fallback if absent
GOOGLE_API_KEY=your_google_ai_studio_key
# OPENAI_API_KEY=your_openai_key
# Override model (e.g. google-gla:gemini-2.0-flash, openai:gpt-4o-mini)
# PYDANTIC_AI_MODEL=google-gla:gemini-2.5-flash

# ── Observability ─────────────────────────────────────────────────────────────
LOGFIRE_TOKEN=your_logfire_token

# ── CORS (production) ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (your Render frontend URL)
# CORS_ORIGINS=https://arcanalytics-frontend.onrender.com

# ── Frontend (set in Render dashboard for the frontend service) ───────────────
# NEXT_PUBLIC_BACKEND_URL=https://arcanalytics-backend.onrender.com
