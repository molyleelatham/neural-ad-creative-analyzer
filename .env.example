# ─────────────────────────────────────────────────────────────────────────────
# Arcanalytics — environment variables
# Copy this file to .env (repo root) and fill in real values.
# backend/.env also works and takes precedence over .env for duplicate keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── TribeV2 / Modal ───────────────────────────────────────────────────────────
# Base URL of your deployed TribeV2 Modal endpoint.
# Find it in the Modal dashboard after: modal deploy modal_app.py
# e.g. https://molyleelatham--tribev2-ad-scorer-tribeapp-serve.modal.run
TRIBEV2_URL=

# Request timeout in seconds (Modal cold starts can take 30-60s, default 120)
# TRIBEV2_TIMEOUT=120

# ── SAM3 / Roboflow ──────────────────────────────────────────────────────────
# Required for real visual-segment detection (falls back to mock if unset).
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW_ID=
# ROBOFLOW_API_URL=https://serverless.roboflow.com
# ROBOFLOW_IMAGE_KEY=image

# ── AI Narrative (Pydantic AI) ────────────────────────────────────────────────
# Set at least one of these to enable LLM-generated explanations/recommendations.
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Override model (e.g. google-gla:gemini-2.0-flash, openai:gpt-4o)
# PYDANTIC_AI_MODEL=
# Set GEMINI_MODEL to pick a specific Gemini variant when using Google only
# GEMINI_MODEL=google-gla:gemini-2.5-flash

# Offline demo narrative (no LLM calls, uses Pydantic AI TestModel)
# ARCA_NARRATIVE_DEMO_MODE=false

# ── Observability (Logfire) ───────────────────────────────────────────────────
# Set to enable Logfire tracing for FastAPI + Pydantic AI.
LOGFIRE_TOKEN=

# ── Misc ──────────────────────────────────────────────────────────────────────
# Set to "brain" to switch frontend copy to neuroscience terminology.
# ARCA_COPY_MODE=neutral
